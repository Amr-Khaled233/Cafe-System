# ---- قاعدة البيانات ----
# على Vercel: اربط MongoDB Atlas من Storage > Marketplace وهو بيحقن MONGODB_URI
# لوحده — ساعتها مش محتاج تكتب حاجة هنا خالص.
# محلياً: mongodb://127.0.0.1:27017/cafe
# الكود بيقرا MONGO_URI أو MONGODB_URI أو DATABASE_URL — أي واحد فيهم يكفي.
MONGO_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/cafe?retryWrites=true&w=majority

# ---- الأمان ----
# غيّره لأي نص عشوائي طويل قبل النشر
JWT_SECRET=change-me-to-a-long-random-string
# مدة الجلسة بالساعات
JWT_HOURS=12

# ---- السيرفر ----
PORT=4100
NODE_ENV=development
# المنطقة الزمنية المستخدمة في تجميع التقارير والإحصائيات
TZ_NAME=Africa/Cairo
# العملة المعروضة في الواجهة
VITE_CURRENCY=EGP

# ---- الإيميل (نسيت الباسورد) ----
# جيميل مابيقبلش باسورد حسابك العادي. لازم App Password:
#   1. فعّل التحقق بخطوتين: myaccount.google.com/security
#   2. ولّد باسورد تطبيق: myaccount.google.com/apppasswords
#   3. حط الـ 16 حرف في SMTP_PASS (من غير مسافات)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your.cafe@gmail.com
SMTP_PASS=abcdefghijklmnop
SMTP_FROM="نظام الكافيه <your.cafe@gmail.com>"

# رابط الموقع — بيتحط في إيميل إعادة التعيين
APP_URL=https://your-project.vercel.app
# مدة صلاحية رابط إعادة التعيين بالدقايق
RESET_TTL_MINUTES=30

# ---- سلوك المخزون ----
# true = يرفض إضافة صنف خاماته مش كافية بكود OUT_OF_STOCK
# false = يسمح ويسجّل العجز بالسالب وينبّه المدير
BLOCK_WHEN_OUT_OF_STOCK=false

# ---- بيانات الـ seed ----
SEED_MANAGER_USERNAME=manager
SEED_MANAGER_PASSWORD=manager123
SEED_RECEPTION_USERNAME=reception
SEED_RECEPTION_PASSWORD=reception123
